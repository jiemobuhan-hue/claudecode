<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZenergyBFSI.View" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:StateCards="clr-namespace:ZenergyBFSI.View.StateCards" x:Class="ZenergyBFSI.View.UC_Setting"
             mc:Ignorable="d"
             FontSize="16" Background="White"
             d:DesignHeight="917.5" d:DesignWidth="1278.5" Loaded="UserControl_Loaded"
             >
    <UserControl.Resources>
        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="#FF4092DA"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Style.Resources>
                <DropShadowEffect x:Key="Shadow" BlurRadius="12" Opacity="0.05" ShadowDepth="4" Direction="270"/>
            </Style.Resources>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <!--<Setter Property="Effect" Value="{StaticResource Shadow}"/>-->
        </Style>

        <Style x:Key="CardHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4338CA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="580"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <dxr:RibbonControl Grid.Row="0" RibbonStyle="Office2019" Margin="0,-67,0,0" ShowApplicationButton="False">
            <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                <dxr:RibbonPage Caption="功能">
                    <dxr:RibbonPageGroup Caption="本地配置" ShowCaptionButton="False" IsCaptionButtonEnabled="True">
                        <dxb:BarButtonItem Content="保存" ItemClick="Save_ItemClick" LargeGlyph="{dx:DXImage Images/XAF/Action_Save_32x32.png}"/>
                        <dxb:BarButtonItem Content="读取" ItemClick="Load_ItemClick" LargeGlyph="{dx:DXImage Images/XAF/Action_Reload_32x32.png}" IsVisible="False"/>
                    </dxr:RibbonPageGroup>
                    <dxr:RibbonPageGroup Caption="其他" IsVisible="False">
                        <dxb:BarButtonItem Content="登出" ItemClick="Logout_ItemClick" RibbonStyle="All" LargeGlyph="{dx:DXImage Images/Actions/Cancel_32x32.png}"/>
                    </dxr:RibbonPageGroup>
                </dxr:RibbonPage>
            </dxr:RibbonDefaultPageCategory>
        </dxr:RibbonControl>
        <Grid Grid.Row="1">

            <StateCards:UC_SettingsPages x:Name="SettingPages" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" />

        </Grid>
        <!--<TextBlock Grid.Row="2" Text="MOM参数:" Margin="5,0,0,0" FontWeight="Bold"/>
        <dxg:GridControl x:Name="gridControl" Grid.Row="3" >
            <dxg:GridControl.View>
                <dxg:TableView x:Name="gridView" AllowPerPixelScrolling="True" AutoWidth="True" AllowMoveColumnToDropArea="False" AllowScrollingOnDrag="False" AllowEditing="True">
                    <dxg:TableView.RuntimeLocalizationStrings>
                        <dxg:GridRuntimeStringCollection>
                            <dxg:RuntimeStringIdInfo Id="GridGroupPanelText" Value=" "/>
                        </dxg:GridRuntimeStringCollection>
                    </dxg:TableView.RuntimeLocalizationStrings>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridColumn FieldName="ParameterCode" Header="参数代码" Width="200"/>
            <dxg:GridColumn FieldName="ParameterType" Header="参数类型" Width="50"/>
            <dxg:GridColumn FieldName="Description" Header="描述" Width="300"/>
            <dxg:GridColumn FieldName="TargetValue" Header="目标值" Width="100"/>
            <dxg:GridColumn FieldName="UpperSpecificationsLimit" Header="规格上限" Width="100"/>
            <dxg:GridColumn FieldName="LowerSpecificationsLimit" Header="规格下限" Width="100"/>
            <dxg:GridColumn FieldName="UpperControlLimit" Header="控制上限" Width="100"/>
            <dxg:GridColumn FieldName="LowerControlLimit" Header="控制下限" Width="100"/>
            <dxg:GridColumn FieldName="UOMCode" Header="UOMCode" Width="100"/>
        </dxg:GridControl>-->
    </Grid>
</UserControl>
