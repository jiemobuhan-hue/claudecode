<UserControl x:Class="ZenergyBFSI.View.StateCards.UC_StatesCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="{DynamicResource MaterialDesignPaper}"
             xmlns:local="clr-namespace:ZenergyBFSI.View.StateCards"
              xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" 
             mc:Ignorable="d" 
             d:DesignHeight="731" d:DesignWidth="1004.5">
    <UserControl.Resources>

        <!-- ── 数字大字体样式 ───────────────────────────────── -->
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="38"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="Margin"         Value="0,6,0,4"/>
            <Setter Property="FontFamily"     Value="Consolas"/>
        </Style>

        <!-- ── KPI 副标签 ──────────────────────────────────── -->
        <Style x:Key="KpiSubStyle" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="Foreground"     Value="{DynamicResource MaterialDesignBodyLight}"/>
        </Style>

        <!-- ── 卡片内标题行 ────────────────────────────────── -->
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="FontWeight"     Value="Medium"/>
            <Setter Property="Foreground"     Value="{DynamicResource MaterialDesignBodyLight}"/>
            <!--<Setter Property="LetterSpacing"  Value="1"/>-->
        </Style>

        <!-- ── 时段/图表区 Section 标题 ──────────────────── -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontWeight"     Value="Medium"/>
            <Setter Property="Foreground"     Value="{DynamicResource MaterialDesignBodyLight}"/>
            <Setter Property="Margin"         Value="0,0,0,8"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="Medium"/>
            <Setter Property="Foreground"  Value="{DynamicResource MaterialDesignBodyLight}"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="36"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="Margin"      Value="0,6,0,2"/>
        </Style>
        <Style x:Key="KpiSub" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources> 
    <!-- ═══ 根容器：带滚动的外层 DockPanel ═══════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <DockPanel Margin="16" LastChildFill="True">

            <!-- ┌───────────────────────────────────────────────────┐
                 │  顶部工具栏                                       │
                 └───────────────────────────────────────────────────┘ -->
            <md:Card DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="ViewDashboard" Width="22" Height="22"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Text="产线视觉检测看板"
                                   FontSize="15" FontWeight="Bold" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Production KPI Dashboard"
                                   FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>

                    <!-- 右侧控件组 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- 班次选择 -->
                        <TextBlock Text="班次" VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   FontSize="12"/>
                        <ComboBox x:Name="CmbShift" Width="80" SelectedIndex="0" Margin="10,0,0,0"
                                  md:HintAssist.Hint="班次">
                            <ComboBoxItem Content="全天"/>
                            <ComboBoxItem Content="A 班"/>
                            <ComboBoxItem Content="B 班"/>
                            <ComboBoxItem Content="C 班"/>
                        </ComboBox>

                        <!-- 日期选择 -->
                        <TextBlock Text="日期" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   FontSize="12"/>
                        <DatePicker x:Name="DpDate" Width="130" Margin="10,0,0,0"
                                    md:HintAssist.Hint="选择日期"/>

                        <!-- 刷新按钮 -->
                        <Button x:Name="BtnRefresh" Margin="10,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="刷新" Padding="14,6"
                                md:ButtonAssist.CornerRadius="6">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"  >
                                        <md:PackIcon Kind="Refresh" Width="16" Height="16" Margin="4,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <!-- 实时时钟 -->
                        <Border Background="{DynamicResource PrimaryHueLightBrush}" Margin="10,0,0,0"
                                CornerRadius="6" Padding="10,5">
                            <TextBlock x:Name="TxtClock" Text="00:00:00"
                                       FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </md:Card>

            <!-- ┌───────────────────────────────────────────────────┐
                 │  主内容区                                         │
                 └───────────────────────────────────────────────────┘ -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- KPI 卡片 -->
                    <RowDefinition Height="220"/>
                    <!-- 图表行 -->
                    <RowDefinition Height="*"/>
                    <!-- 记录表格 -->
                </Grid.RowDefinitions>

                <!-- ══════════════ 第一行：KPI 卡片 ═══════════════ -->
                <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,12">

                    <!-- 卡片 1：总检测数 -->
                    <md:Card Margin="0,0,10,0" Padding="16,14">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" >
                                    <md:PackIcon Kind="ChartBar" Width="16" Height="16" Margin="6,0,0,0"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="总检测数" Style="{StaticResource CardLabelStyle}"  Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTotal" Text="0"
                                           Style="{StaticResource KpiValueStyle}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock x:Name="TxtTotalSub" Text="今日累计"
                                           Style="{StaticResource KpiSubStyle}"/>
                            </StackPanel>
                            <!-- 装饰图标 -->
                            <md:PackIcon Kind="PackageVariantClosed" Width="48" Height="48"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Opacity="0.06" Margin="0,0,8,8"/>
                        </Grid>
                    </md:Card>

                    <!-- 卡片 2：合格数 OK -->
                    <md:Card Margin="0,0,10,0" Padding="16,14">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"  >
                                    <md:PackIcon Kind="CheckCircle" Width="16" Height="16"
                                                 Margin="8,0,0,0"
                                                 Foreground="#4CAF50"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="合格数 (OK)" Style="{StaticResource CardLabelStyle}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOk" Text="0"
                                           Style="{StaticResource KpiValueStyle}"
                                           Foreground="#4CAF50"/>
                                <TextBlock x:Name="TxtOkSub" Text="--"
                                           Style="{StaticResource KpiSubStyle}"/>
                            </StackPanel>
                            <md:PackIcon Kind="CheckAll" Width="48" Height="48"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Opacity="0.06"/>
                        </Grid>
                    </md:Card>

                    <!-- 卡片 3：不合格数 NG -->
                    <md:Card Margin="0,0,10,0" Padding="16,14">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"  >
                                    <md:PackIcon Kind="CloseCircle" Width="16" Height="16" Margin="6,0,0,0"
                                                 Foreground="#F44336"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="不合格数 (NG)" Style="{StaticResource CardLabelStyle}"  Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtNg" Text="0"
                                           Style="{StaticResource KpiValueStyle}"
                                           Foreground="#F44336"/>
                                <TextBlock x:Name="TxtNgSub" Text="--"
                                           Style="{StaticResource KpiSubStyle}"/>
                            </StackPanel>
                            <md:PackIcon Kind="AlertCircle" Width="48" Height="48"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Opacity="0.06"/>
                        </Grid>
                    </md:Card>

                    <!-- 卡片 4：良品率 -->
                    <md:Card Margin="0,0,10,0" Padding="16,14">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" >
                                    <md:PackIcon Kind="Speedometer" Width="16" Height="16"  Margin="6,0,0,0"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="良品率" Style="{StaticResource CardLabelStyle}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtRate" Text="--%"
                                           Style="{StaticResource KpiValueStyle}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock x:Name="TxtRateSub" Text="目标 ≥99.5%"
                                           Style="{StaticResource KpiSubStyle}"/>
                            </StackPanel>
                            <md:PackIcon Kind="TrendingUp" Width="48" Height="48"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Opacity="0.06"/>
                        </Grid>
                    </md:Card>

                    <!-- 卡片 5：产线状态大灯 -->
                    <md:Card Padding="16,14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                            <TextBlock Text="产线状态" Style="{StaticResource CardLabelStyle}" Margin="8,0,0,0"
                                       HorizontalAlignment="Center"/>

                            <!-- 状态灯（Ellipse，颜色绑定到 ViewModel） -->
                            <Grid Width="80" Height="80" HorizontalAlignment="Center"  Margin="8,0,0,0">
                                <!-- 光晕外环 -->
                                <Ellipse x:Name="StatusGlow" Width="80" Height="80"
                                         Fill="Transparent"
                                         Stroke="#4CAF50" StrokeThickness="2"
                                         Opacity="0.4"/>
                                <!-- 主灯 -->
                                <Ellipse x:Name="StatusLight" Width="60" Height="60"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#66BB6A" Offset="0"/>
                                            <GradientStop Color="#2E7D32" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#4CAF50" BlurRadius="16"
                                                          ShadowDepth="0" Opacity="0.8"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <!-- 状态文字 -->
                                <TextBlock x:Name="TxtStatus" Text="OK"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="White"/>
                            </Grid>

                            <!-- 最近电芯码 -->
                            <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                    CornerRadius="12" Padding="8,3">
                                <TextBlock x:Name="TxtLastCellCode" Text="--"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtLastTime" Text="--"
                                       FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </md:Card>
                </UniformGrid>

                <!-- ══════════════ 第二行：图表区 ════════════════ -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <!-- 时段产量图 -->
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <!-- NG 占比图 -->
                    </Grid.ColumnDefinitions>

                    <!-- 时段产量柱状图（占位容器，接入 LiveCharts2 / OxyPlot） -->
                    <md:Card Grid.Column="0" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal"   Margin="0,0,0,8">
                                <md:PackIcon Kind="ChartBar" Width="16" Height="16" Margin="6,0,0,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="时段产量分布（按小时）" 
                                           Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            </StackPanel>
                            <!-- ↓ 将此 Border 替换为 LiveCharts:CartesianChart 或 OxyPlot:PlotView -->
                            <Border Grid.Row="1" BorderThickness="1"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    CornerRadius="6" Background="{DynamicResource MaterialDesignCardBackground}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Opacity="0.35" >
                                    <md:PackIcon Kind="ChartBar" Width="40" Height="40"  Margin="6,0,0,0"
                                                 HorizontalAlignment="Center"/>
                                    <TextBlock Text="时段产量柱状图（接入图表控件）" Margin="6,0,0,0"
                                               FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="推荐：LiveCharts2 / OxyPlot" Margin="6,0,0,0"
                                               FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </md:Card>

                    <!-- NG 类型占比图 -->
                    <md:Card Grid.Column="2" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal"  Margin="0,0,0,8">
                                <md:PackIcon Kind="ChartDonut" Width="16" Height="16" Margin="6,0,0,0"
                                             Foreground="#F44336"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="NG 类型占比"
                                           Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            </StackPanel>
                            <!-- ↓ 替换为图表控件 -->
                            <Border Grid.Row="1" BorderThickness="1"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    CornerRadius="6" Background="{DynamicResource MaterialDesignCardBackground}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Opacity="0.35" >
                                    <md:PackIcon Kind="ChartDonut" Width="36" Height="36" Margin="6,0,0,0"
                                                 HorizontalAlignment="Center"/>
                                    <TextBlock Text="NG 类型饼图" FontSize="12" HorizontalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </md:Card>
                </Grid>

                <!-- ══════════════ 第三行：最近检测记录 ═════════ -->
                <md:Card Grid.Row="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 表头工具行 -->
                        <Grid Grid.Row="0" Margin="16,12,16,8">
                            <StackPanel Orientation="Horizontal"   VerticalAlignment="Center">
                                <md:PackIcon Kind="FormatListBulleted" Width="16" Height="16" Margin="6,0,0,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="最近检测记录" FontSize="13" FontWeight="Medium" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <!-- 数量 Chip -->
                                <md:Chip x:Name="ChipRecordCount" Content="0 条"
                                         IsDeletable="False" Margin="4,0,0,0"
                                         Background="{DynamicResource PrimaryHueLightBrush}"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </StackPanel>
                            <!-- 右侧：仅显示 NG 切换 -->
                            <ToggleButton x:Name="TglNgOnly"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          ToolTip="仅显示 NG"/>
                            <TextBlock Text="仅看 NG" HorizontalAlignment="Right"
                                       Margin="0,0,52,0" VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </Grid>

                        <Separator Grid.Row="0" VerticalAlignment="Bottom"
                                   Background="{DynamicResource MaterialDesignDivider}"/>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1"
                                  x:Name="DgRecords"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  SelectionMode="Single"
                                  md:DataGridAssist.CellPadding="12,8"
                                  md:DataGridAssist.ColumnHeaderPadding="12,10"
                                  MaxHeight="220"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="电芯码" Binding="{Binding CellCode}"
                                                    Width="180" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="时间"   Binding="{Binding DateTime}"
                                                    Width="155" FontFamily="Consolas" FontSize="11"/>
                                <DataGridTextColumn Header="产线"   Binding="{Binding LineId}"   Width="70"/>
                                <DataGridTextColumn Header="工位"   Binding="{Binding StationId}" Width="70"/>

                                <!-- 判定结果列（模板列，带颜色 Chip） -->
                                <DataGridTemplateColumn Header="判定" Width="80" SortMemberPath="OverallResult">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OverallResult}" Value="OK">
                                                                <Setter Property="Background" Value="#1A4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OverallResult}" Value="NG">
                                                                <Setter Property="Background" Value="#1AF44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding OverallResult}"
                                                           FontFamily="Consolas" FontWeight="Bold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OverallResult}" Value="OK">
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OverallResult}" Value="NG">
                                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- NG 类型标签列 -->
                                <DataGridTemplateColumn Header="NG 类型" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- NgTypes 是 string，如 "SCRATCH|DENT"，代码绑定 ItemsControl -->
                                            <ItemsControl ItemsSource="{Binding NgTypeList}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="3" Margin="2,1"
                                                                Background="#1AFFC107" Padding="5,1">
                                                            <TextBlock Text="{Binding}" FontSize="10"
                                                                       Foreground="#FFC107"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="耗时(ms)" Binding="{Binding ProcessMs}"
                                                    Width="90" FontFamily="Consolas" FontSize="11"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>

            </Grid>
        </DockPanel>
    </ScrollViewer>
</UserControl>
