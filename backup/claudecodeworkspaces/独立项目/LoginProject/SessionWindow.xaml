<Window x:Class="LoginProject.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="会话管理"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部用户信息区域 -->
        <materialDesign:Card Grid.Row="0"
                             UniformCornerRadius="0"
                             materialDesign:ElevationAssist.Elevation="Dp2"
                             Margin="0">
            <Grid Background="#667eea" Height="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 用户头像 -->
                <Border Grid.Column="0"
                        Width="60"
                        Height="60"
                        CornerRadius="30"
                        Background="White"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Account"
                                             Width="40"
                                             Height="40"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="#667eea"/>
                </Border>

                <!-- 用户信息 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock x:Name="txtUserName"
                               Text="管理员"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="txtLoginTime"
                               Text="登录时间: 2026-04-29 10:00:00"
                               FontSize="12"
                               Foreground="White"
                               Opacity="0.8"
                               Margin="0,5,0,0"/>
                    <TextBlock x:Name="txtUserRole"
                               Text="角色: 系统管理员"
                               FontSize="12"
                               Foreground="White"
                               Opacity="0.8"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- 会话信息区域 -->
        <StackPanel Grid.Row="1" Margin="20" VerticalAlignment="Center">
            <TextBlock Text="当前会话信息"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="会话ID:" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtSessionId" Text="SESSION_20260429001"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="用户IP:" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtUserIP" Text="127.0.0.1"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="系统版本:" FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtVersion" Text="V1.0.0"/>
            </Grid>
        </StackPanel>

        <!-- 底部按钮区域 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20">
            <Button x:Name="btnLogout"
                    Content="退出登录"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,10,0"
                    Click="btnLogout_Click">
                <Button.BorderBrush>
                    <SolidColorBrush Color="#f44336"/>
                </Button.BorderBrush>
                <Button.Foreground>
                    <SolidColorBrush Color="#f44336"/>
                </Button.Foreground>
            </Button>
            <Button x:Name="btnClose"
                    Content="关闭"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#667eea"
                    Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>