<UserControl x:Class="ZenergyBFSI.View.PA_Signal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZenergyBFSI.View"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
             mc:Ignorable="d" 
             d:DesignHeight="48" d:DesignWidth="48">
    <Grid>
        <Button x:Name="yes" Visibility="Collapsed" Background="Transparent">
            <Image Height="48" Source="{dx:DXImage Images/XAF/State_Validation_Valid_48x48.png}"/>
        </Button>
        <Button x:Name="no" Background="Transparent">
            <Image Height="48" Source="{dx:DXImage Images/XAF/State_Validation_Invalid_48x48.png}"/>
        </Button>
    </Grid>
</UserControl>
