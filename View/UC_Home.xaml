                    </dxr:RibbonPageGroup>
                    <dxr:RibbonPageGroup Caption="点检">
                        <dxb:BarButtonItem Content="点检记录" RibbonStyle="All" LargeGlyph="{dx:DXImage Images/Filter Elements/CheckButtons_32x32.png}" ItemClick="Inspection_ItemClick" />
                    </dxr:RibbonPageGroup>
                </dxr:RibbonPage>
            </dxr:RibbonDefaultPageCategory>
        </dxr:RibbonControl>
        <Grid Grid.Row="1" Margin="10,15,10,10" Grid.RowSpan="2" Background="White">

