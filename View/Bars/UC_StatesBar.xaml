<UserControl x:Class="ZenergyBFSI.View.Bars.UC_StatesBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ZenergyBFSI.View.Bars"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DataContext="{d:DesignInstance Type=local:UC_StatesBarVM}"
             mc:Ignorable="d" d:DesignWidth="1000"
              >
    <Grid>
        <StatusBar Height="50"
                   Background="Transparent"
                   BorderBrush="{DynamicResource MaterialDesignDivider}"
                   BorderThickness="0,1,0,0"
            >
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- 列0: 模式指示 -->
            <StatusBarItem Grid.Column="0">
                <Border Background="{Binding IsAutoMode}"
                        CornerRadius="4" Padding="8,2">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="{Binding ModeIcon}"
                                                 Foreground="Black"
                                                 VerticalAlignment="Center"
                                                 Width="16" Height="16"/>
                        <TextBlock Text="{Binding ModeText}"
                                   Foreground="{Binding ModeColor}"
                                   Margin="5,0,0,0"
                                   FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StatusBarItem>

            <!-- 列2: 系统日志 -->
            <StatusBarItem Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Width="16" Opacity="0.6"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SystemLogMessage}"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Opacity="0.8"
                               FontSize="12"/>
                </StackPanel>
            </StatusBarItem>

            <!-- 列3: 自动机状态 + 心跳 + 故障计数 -->
            <StatusBarItem Grid.Column="3">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="5,0"
                                ToolTip="{Binding AutomatonStateText}">
                        <TextBlock Text="自动" VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,3,0" Opacity="0.6"/>
                        <Ellipse Width="14" Height="14"
                                 Fill="{Binding AutomatonStateColor}"
                                 VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4"
                                                  Color="{Binding AutomatonStateColor}"
                                                  ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5,0"
                                ToolTip="{Binding HeartbeatStateText}">
                        <TextBlock Text="心跳" VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,3,0" Opacity="0.6"/>
                        <Ellipse Width="14" Height="14"
                                 Fill="{Binding HeartbeatStateColor}"
                                 VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4"
                                                  Color="{Binding HeartbeatStateColor}"
                                                  ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorCountText}"
                               Foreground="Red"
                               FontWeight="Bold"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Visibility="{Binding ErrorCountVisible}"/>
                </StackPanel>
            </StatusBarItem>

            <!-- 列4: 8工位指示灯条 -->
            <StatusBarItem Grid.Column="4">
                <StackPanel Orientation="Horizontal"
                            ToolTip="工位状态: 来料1~4 / 分流1~4">
                    <TextBlock Text="工位" VerticalAlignment="Center"
                               FontSize="10" Margin="0,0,4,0" Opacity="0.5"/>
                    <ItemsControl ItemsSource="{Binding StationDots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="11" Height="11"
                                         Fill="{Binding Color}"
                                         Margin="1.5,0"
                                         ToolTip="{Binding ToolTip}"
                                         VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StatusBarItem>

            <!-- 列5: PLC + MOM -->
            <StatusBarItem Grid.Column="5">
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <StackPanel Orientation="Horizontal" Margin="10,0"
                                ToolTip="PLC 通讯状态">
                        <TextBlock Text="PLC" VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,5,0" Opacity="0.7"/>
                        <Ellipse Width="18" Height="18"
                                 Fill="{Binding PlcStatusColor}"
                                 VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="5"
                                                  Color="{Binding PlcStatusColor}"
                                                  ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="10,0"
                                ToolTip="MES 系统连接">
                        <TextBlock Text="MOM" VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,5,0" Opacity="0.7"/>
                        <Ellipse Width="18" Height="18"
                                 Fill="{Binding MesStatusColor}"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StatusBarItem>

            <!-- 列6: 时钟 -->
            <StatusBarItem Grid.Column="6" Margin="10,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTime, StringFormat='HH:mm:ss'}"
                               FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CurrentTime, StringFormat='yyyy/MM/dd'}"
                               FontSize="9" Opacity="0.5"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
