<UserControl x:Class="ZenergyBFSI.View.UC_History"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" 
             xmlns:local="clr-namespace:ZenergyBFSI.View"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="518" d:DesignWidth="1156"
             FontSize="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <dxr:RibbonControl Grid.Row="0" RibbonStyle="Office2019" Margin="0,-67,0,0" ShowApplicationButton="False">
            <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                <dxr:RibbonPage Caption="功能">
                    <dxr:RibbonPageGroup Caption="基本操作" ShowCaptionButton="False" IsCaptionButtonEnabled="True">
                        <dxb:BarEditItem Content="开始时间" EditWidth="200" EditHeight="28" EditValue="{Binding StartTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:DateEditSettings Mask="yyyy-MM-dd HH:mm:ss" MaskUseAsDisplayFormat="True"/>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                        <dxb:BarEditItem Content="结束时间" EditWidth="200" EditHeight="28" EditValue="{Binding EndTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:DateEditSettings Mask="yyyy-MM-dd HH:mm:ss" MaskUseAsDisplayFormat="True"/>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                        <dxb:BarButtonItem Content="查询"   LargeGlyph="{dx:DXImage Images/Zoom/Zoom_32x32.png}" RibbonStyle="All" ItemClick="Search_ItemClick"/>
                        <dxb:BarButtonItem IsVisible="False" Content="设置TS"  LargeGlyph="{dx:DXImage Images/Actions/ConvertToRange_32x32.png}" RibbonStyle="All" ItemClick="SetTS_ItemClick" />
                    </dxr:RibbonPageGroup>
                    <dxr:RibbonPageGroup Caption="其他">
                        <dxb:BarButtonItem Content="导出" RibbonStyle="All" LargeGlyph="{dx:DXImage Images/Support/Article_32x32.png}" ItemClick="Export_ItemClick" />
                        <dxb:BarButtonItem Content="打印"  RibbonStyle="All" LargeGlyph="{dx:DXImage Images/Print/Print_32x32.png}" ItemClick="Print_ItemClick" />
                        <dxb:BarButtonItem Content="登出"  RibbonStyle="All" LargeGlyph="{dx:DXImage Images/Actions/Cancel_32x32.png}" ItemClick="Logout_ItemClick" />
                    </dxr:RibbonPageGroup>
                </dxr:RibbonPage>
            </dxr:RibbonDefaultPageCategory>
        </dxr:RibbonControl>
        <dxg:GridControl Grid.Row="1" 
                         Name="gridControl"
                         ItemsSource="{Binding InfoList,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <dxg:GridControl.View>
                <dxg:TableView x:Name="gridView"
                               AllowEditing="True"
                               AllowScrollAnimation="True"
                               AllowSorting="False"
                               ColumnFilterPopupMode="ExcelSmart"
                               HighlightItemOnHover="True">
                    <dxg:TableView.FormatConditions >
                        <dxg:FormatCondition FieldName="工艺结果" Expression="[工艺结果] LIKE 'NG'" PredefinedFormatName="LightRedFillWithDarkRedText" />
                        <dxg:FormatCondition FieldName="工艺结果" Expression="[工艺 结果] LIKE 'OK'" PredefinedFormatName="GreenFillWithDarkGreenText" />
                    </dxg:TableView.FormatConditions>
                    <dxg:TableView.RuntimeLocalizationStrings>
                        <dxg:GridRuntimeStringCollection>
                            <dxg:RuntimeStringIdInfo Id="GridGroupPanelText" Value=" "/>
                        </dxg:GridRuntimeStringCollection>
                    </dxg:TableView.RuntimeLocalizationStrings>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="电芯码" Header="电芯码" Width="280"/>
                <dxg:GridColumn FieldName="进站时间" Header="进站时间" Width="180"/>
                <dxg:GridColumn FieldName="检验位置" Header="检验位置" Width="100"/>
                <dxg:GridColumn FieldName="是否复投" Header="是否复投" Width="100"/>
                <dxg:GridColumn FieldName="NG类型数量" Header="NG类型数量" Width="100"/>
                <dxg:GridColumn FieldName="NG类型1" Header="NG类型1描述" Width="100"/>
                <dxg:GridColumn FieldName="NG类型2" Header="NG类型2描述" Width="100"/>
                <dxg:GridColumn FieldName="NG类型3" Header="NG类型3描述" Width="100"/>
                <dxg:GridColumn FieldName="NG类型4" Header="NG类型4描述" Width="100"/>
                <dxg:GridColumn FieldName="NG类型5" Header="NG类型5描述" Width="100"/>
                <dxg:GridColumn FieldName="NG类型6" Header="NG类型6描述" Width="100"/>
                <dxg:GridColumn FieldName="NG类型7" Header="NG类型7描述" Width="100"/>
                <dxg:GridColumn FieldName="NG类型8" Header="NG类型8描述" Width="100"/>
                <dxg:GridColumn FieldName="入站结果" Header="入站结果" Width="100"/>
                <dxg:GridColumn FieldName="出站结果" Header="出站结果" Width="100"/>
                <dxg:GridColumn FieldName="出站时间" Header="出站时间" Width="100"/>
                <dxg:GridColumn FieldName="人工复判次数" Header="出站时间" Width="100"/>
            </dxg:GridControl.Columns>
        </dxg:GridControl>
    </Grid>
</UserControl>
