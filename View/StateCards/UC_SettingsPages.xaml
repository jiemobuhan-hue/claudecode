<UserControl x:Class="ZenergyBFSI.View.StateCards.UC_SettingsPages"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            
             xmlns:local="clr-namespace:ZenergyBFSI.View.StateCards"
             mc:Ignorable="d" 
             d:DesignHeight="2500.4" d:DesignWidth="2200">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E6E6E6" BorderThickness="0,0,1,0">
                <StackPanel Margin="10,30,0,0">
                    <ListBox Background="Transparent" BorderThickness="0" SelectedIndex="0"  >
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="20,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="Transparent" BorderBrush="#0057FF" BorderThickness="0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="BorderThickness" Value="4,0,0,0"/>
                                                    <Setter TargetName="border" Property="Background" Value="#F0F6FF"/>
                                                    <Setter Property="Foreground" Value="#0057FF"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="常规"/>
                        <ListBoxItem Content="检测参数"/>
                        <ListBoxItem Content="产品型号"/>
                    </ListBox>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,30,40,40" Width="800" HorizontalAlignment="Left">

                    <TextBlock Text="常规配置" FontSize="18" FontWeight="Bold" Margin="0,0,0,25"/>

                    <Border Background="White" BorderBrush="#E6E6E6" BorderThickness="1" CornerRadius="3" Padding="30" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="系统运行" FontSize="11" FontWeight="Bold" Foreground="#3C3C3C" Margin="0,0,0,15"/>
                            <TextBlock Text="这里是一些关于系统运行的常规功能项" FontSize="13" Foreground="#191919" Margin="0,0,0,10" Style="{StaticResource MaterialDesignBody1TextBlock}"/>

                            <CheckBox Content="开机自启动" IsChecked="True" Margin="0,8"/>
                            <Grid Height="35" Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="视觉检测数据库IP" Text="视觉检测数据库IP" 
                                           FontSize="11"
                                           FontWeight="Bold"  
                                           Foreground="#3C3C3C" 
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                          />
                                <TextBox
                                    Grid.Column="1"
                                    VerticalContentAlignment="Center" 
                                    Style="{StaticResource MaterialDesignFilledTextBox }"
                                    Padding="10,0" 
                                    BorderBrush="#CCCCCC"
                                    Tag="Enter username"
                                    />

                            </Grid>
                            <Grid Height="35" Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Text="电气PLC配置IP"
                                    FontSize="11" FontWeight="Bold" 
                                    Foreground="#3C3C3C"  
                                    />
                                <TextBox
                                    Grid.Column="1" 
                                     Style="{StaticResource MaterialDesignFilledTextBox }"
                                    VerticalContentAlignment="Center" 
                                    Padding="10,0" 
                                    BorderBrush="#CCCCCC" 
                                    Tag="Enter username"  />
                            </Grid>
                            <CheckBox Content="勾选项一" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="视觉检测参数" FontSize="18" FontWeight="Bold" Margin="0,0,0,25"/>
                    <Border Background="White" BorderBrush="#E6E6E6" BorderThickness="1" CornerRadius="3" Padding="30" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="视觉检测参数一" FontSize="11" FontWeight="Bold" Foreground="#3C3C3C"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox
                                    Grid.Column="1" 
                                    Style="{StaticResource MaterialDesignFilledTextBox }"
                                    VerticalContentAlignment="Center" 
                                    Padding="10,0" BorderBrush="#CCCCCC" 
                                      />
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="视觉检测参数二" FontSize="11" FontWeight="Bold" Foreground="#3C3C3C"  HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                <RadioButton Content="On" IsChecked="True" Margin="20,0,20,0" Width="96"/>
                                <RadioButton Content="Off"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="产品型号" FontSize="18" FontWeight="Bold" Margin="0,0,0,25"/>
                    <Border Background="White" BorderBrush="#E6E6E6" BorderThickness="1" CornerRadius="3" Padding="30" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="电芯型号" FontSize="11" FontWeight="Bold" Foreground="#3C3C3C" Margin="0,0,0,15"/>
                            <TextBlock Text="电芯型号修改后会影响MOM的提交结果" FontSize="13" Foreground="#191919" TextWrapping="Wrap" Margin="0,0,0,20"/>

                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox VerticalContentAlignment="Center" 
                                         Style="{StaticResource MaterialDesignFilledTextBox }"
                                         Padding="10,0" BorderBrush="#CCCCCC" 
                                         Tag="输入电芯型号"/>
                                <Button Grid.Column="1" Content="确认" Width="80" Margin="10,0,0,0"    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF8F8" BorderBrush="#FFCCCC" BorderThickness="1" CornerRadius="3" Padding="30">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="注销账户" FontSize="11" FontWeight="Bold" Foreground="#CC0000" Margin="0,0,0,10"/>
                                <TextBlock Text="注销当前账户并删除所有用户数据" FontSize="13" Foreground="#191919"/>
                            </StackPanel>
                            <Button Content="注销" DockPanel.Dock="Right" BorderThickness="0"  VerticalAlignment="Center" Foreground="#0057FF" FontWeight="Bold" Background="Transparent"  />
                        </DockPanel>
                    </Border>


                    <TextBlock Text="MOM参数配置" FontSize="18" FontWeight="Bold" Margin="0,20,0,25"/>
                    <Border Background="White" BorderBrush="#E6E6E6" BorderThickness="1" CornerRadius="3"   Width="750">
                        <StackPanel>
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions> 
                                <!-- 刷新 -->
                                <Button x:Name="momBtnRefresh" Padding="14,7"
                                        Grid.Column="0"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        
                                        md:ButtonAssist.CornerRadius="6">
                                    <StackPanel Orientation="Horizontal"  >
                                        <md:PackIcon Margin="4,0,0,0" Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Margin="4,0,0,0" Text="刷新" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- 保存 -->
                                <Button x:Name="momBtnSave" Padding="14,7"
                                        Grid.Column="2"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        md:ButtonAssist.CornerRadius="6">
                                    <StackPanel Orientation="Horizontal"  >
                                        <md:PackIcon Margin="4,0,0,0" Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Margin="4,0,0,0" Text="保存" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"  Height="550" Width="1000" VerticalAlignment="Top">

                                <dxg:GridControl   x:Name="MOMgridControl" 
                                                    
                                                   VerticalAlignment="Top" 
                                                   HorizontalAlignment="Left"
                                                   ItemsSource="{Binding ParamList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="550" Width="1400">
                                    <dxg:GridControl.View>
                                        <dxg:TableView HorizontalAlignment="Left" 
                                                        AllowHorizontalScrollingVirtualization="True"
                                                        ScrollingMode="Smart"
                                                       ShowDataNavigator="True"
                                                       NavigationStyle="Cell"
                                                       DataNavigatorButtons="Navigation, Editing"
                                                        WaitIndicatorType="Panel"
                                                        HorizontalScrollbarVisibility="Auto"
                                                        x:Name="MOMGridView" AllowPerPixelScrolling="True" 
                                                        AllowMoveColumnToDropArea="False"
                                                        AllowScrollingOnDrag="False"
                                                        AllowEditing="True" 
                                                        Width="700">
                                            <dxg:TableView.RuntimeLocalizationStrings>
                                                <dxg:GridRuntimeStringCollection>
                                                    <dxg:RuntimeStringIdInfo Id="GridGroupPanelText" Value=" "/>
                                                </dxg:GridRuntimeStringCollection>
                                            </dxg:TableView.RuntimeLocalizationStrings>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="ParameterCode" Header="参数代码" Width="200"/>
                                    <dxg:GridColumn FieldName="ParameterType" Header="参数类型" Width="50"/>
                                    <dxg:GridColumn FieldName="Description" Header="描述" Width="300"/>
                                    <dxg:GridColumn FieldName="TargetValue" Header="目标值" Width="100"/>
                                    <dxg:GridColumn FieldName="UpperSpecificationsLimit" Header="规格上限" Width="100"/>
                                    <dxg:GridColumn FieldName="LowerSpecificationsLimit" Header="规格下限" Width="100"/>
                                    <dxg:GridColumn FieldName="UpperControlLimit" Header="控制上限" Width="100"/>
                                    <dxg:GridColumn FieldName="LowerControlLimit" Header="控制下限" Width="100"/>
                                    <dxg:GridColumn FieldName="UOMCode" Header="UOMCode" Width="100"/>
                                </dxg:GridControl>


                            </StackPanel>

                        </StackPanel>
                    </Border>
                    <TextBlock Text="PLC参数配置" FontSize="18" FontWeight="Bold" Margin="0,20,0,25"/>
                    <Border Background="White" BorderBrush="#E6E6E6" BorderThickness="1" CornerRadius="3" Margin="0,0,0,20" Width="750">
                        <StackPanel>
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 刷新 -->
                                <Button x:Name="plcBtnRefresh" Padding="14,7"
                                        Grid.Column="0"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
        
                                        md:ButtonAssist.CornerRadius="6">
                                    <StackPanel Orientation="Horizontal"  >
                                        <md:PackIcon Margin="4,0,0,0" Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Margin="4,0,0,0" Text="刷新" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- 保存 -->
                                <Button x:Name="plcBtnSave" Padding="14,7"
                                        Grid.Column="2"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        md:ButtonAssist.CornerRadius="6">
                                    <StackPanel Orientation="Horizontal"  >
                                        <md:PackIcon Margin="4,0,0,0" Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Margin="4,0,0,0" Text="保存" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"  Height="550" Width="1000" VerticalAlignment="Top">

                                <dxg:GridControl   x:Name="PLCGridControl" 
                                                
                                                VerticalAlignment="Top" 
                                                HorizontalAlignment="Left" 
                                                ItemsSource="{Binding PLCAddressList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Height="550" Width="1400">
                                    <dxg:GridControl.View>
                                        <dxg:TableView HorizontalAlignment="Left" 
                                                        AllowHorizontalScrollingVirtualization="True"
                                                        ScrollingMode="Smart"
                                                       ShowDataNavigator="True"
                                                       NavigationStyle="Cell"
                                                       DataNavigatorButtons="Navigation, Editing"
                                                        WaitIndicatorType="Panel"
                                                        HorizontalScrollbarVisibility="Auto"
                                                          AllowPerPixelScrolling="True" 
                                                        AllowMoveColumnToDropArea="False"
                                                        AllowScrollingOnDrag="False"
                                                        AllowEditing="True" 
                                                        Width="700"
                                                        x:Name="PLCGridView" >
                                            <dxg:TableView.RuntimeLocalizationStrings>
                                                <dxg:GridRuntimeStringCollection>
                                                    <dxg:RuntimeStringIdInfo Id="GridGroupPanelText" Value=" "/>
                                                </dxg:GridRuntimeStringCollection>
                                            </dxg:TableView.RuntimeLocalizationStrings>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="Name" Header="信号名称" Width="200"/>
                                    <dxg:GridColumn FieldName="Adress" Header="地址" Width="50"/>
                                    <dxg:GridColumn FieldName="Type" Header="类型" Width="300"/>
                                    <dxg:GridColumn FieldName="Mode" Header="模式" Width="100"/>
                                </dxg:GridControl>


                            </StackPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
