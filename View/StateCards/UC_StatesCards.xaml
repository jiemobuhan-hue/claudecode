<UserControl  x:Class="ZenergyBFSI.View.StateCards.UC_StatesCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="{DynamicResource MaterialDesignPaper}"
             xmlns:local="clr-namespace:ZenergyBFSI.View.StateCards"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" 
              mc:Ignorable="d" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" 
              d:DesignHeight="1093.592" d:DesignWidth="1085.829">
    <UserControl.Resources>

        <!-- ── 数字大字体样式 ───────────────────────────────── -->
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="38"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="Margin"         Value="0,6,0,4"/>
            <Setter Property="FontFamily"     Value="Consolas"/>
        </Style>

        <!-- ── KPI 副标签 ──────────────────────────────────── -->
        <Style x:Key="KpiSubStyle" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="Foreground"     Value="{DynamicResource MaterialDesignBodyDark}"/>
        </Style>

        <!-- ── 卡片内标题行 ────────────────────────────────── -->
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="FontWeight"     Value="Medium"/>
            <Setter Property="Foreground"     Value="{DynamicResource MaterialDesignBodyDark}"/>
            <!--<Setter Property="LetterSpacing"  Value="1"/>-->
        </Style>

        <!-- ── 时段/图表区 Section 标题 ──────────────────── -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontWeight"     Value="Medium"/>
            <Setter Property="Foreground"     Value="{DynamicResource MaterialDesignBodyDark}"/>
            <Setter Property="Margin"         Value="0,0,0,8"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="15"/>
            <Setter Property="FontWeight"  Value="Medium"/>
            <Setter Property="Foreground"  Value="{DynamicResource MaterialDesignBodyDark}"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="36"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="Margin"      Value="0,6,0,2"/>
        </Style>
        <Style x:Key="KpiSub" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyDark}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyDark}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <!-- ═══ 根容器：带滚动的外层 DockPanel ═══════════════════════ -->
    <!-- 整体可滚动容器 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <DockPanel Margin="14" LastChildFill="True">

            <!-- ══ 顶部工具栏 ════════════════════════════════════ -->
            <md:Card DockPanel.Dock="Top" Margin="0,0,0,10" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"  >
                        <md:PackIcon Kind="ViewDashboard" Width="22" Height="22"
                                     Margin="8,0,0,0"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Margin="8,0,0,0" Text="产线视觉检测看板" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock  Text="Production KPI Dashboard" FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- 右侧控件组 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"  >

                        <!-- 班次切换 -->
                        <TextBlock Margin="8,0,0,0" Text="班次" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <Border Margin="8,0,0,0" Background="{DynamicResource MaterialDesignToolBarBackground}"
                                CornerRadius="6" Padding="3">
                            <StackPanel Orientation="Horizontal" >
                                <RadioButton Margin="2,0,0,0" x:Name="RbAll"   Content="全天" IsChecked="True"
                                             Style="{StaticResource MaterialDesignTabRadioButton}"
                                             Checked="ShiftRadio_Checked" Tag="all"/>
                                <RadioButton Margin="2,0,0,0" x:Name="RbA"     Content="A班"
                                             Style="{StaticResource MaterialDesignTabRadioButton}"
                                             Checked="ShiftRadio_Checked" Tag="A"/>
                                <RadioButton Margin="2,0,0,0" x:Name="RbB"     Content="B班"
                                             Style="{StaticResource MaterialDesignTabRadioButton}"
                                             Checked="ShiftRadio_Checked" Tag="B"/>
                                <RadioButton Margin="2,0,0,0" x:Name="RbC"     Content="C班"
                                             Style="{StaticResource MaterialDesignTabRadioButton}"
                                             Checked="ShiftRadio_Checked" Tag="C"/>
                            </StackPanel>
                        </Border>

                        <!-- 日期选择 -->
                        <TextBlock Text="日期" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <DatePicker x:Name="DpDate" Width="130" Margin="5,0,0,0"
                                    md:HintAssist.Hint="选择日期"
                                    SelectedDateChanged="DpDate_SelectedDateChanged"/>

                        <!-- 刷新 -->
                        <Button x:Name="BtnRefresh" Padding="14,7"
                                Margin="5,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                md:ButtonAssist.CornerRadius="6"
                                Click="BtnRefresh_Click">
                            <StackPanel Orientation="Horizontal"  >
                                <md:PackIcon Margin="4,0,0,0" Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Margin="4,0,0,0" Text="刷新" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 实时时钟 -->
                        <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                CornerRadius="6" Padding="10,5">
                            <TextBlock x:Name="TxtClock" Text="00:00:00"
                                       FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </md:Card>

            <!-- ══ 主内容 ════════════════════════════════════════ -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- KPI -->
                    <RowDefinition Height="600"/>
                    <!-- 图表 -->
                    <RowDefinition Height="*"/>
                    <!-- 表格 -->
                </Grid.RowDefinitions>

                <!-- ─ 第一行：KPI 卡片 ──────────────────────────── -->
                <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,10">

                    <!-- 总检测数 -->
                    <md:Card Margin="0,0,8,0" Padding="16,14">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" >
                                    <md:PackIcon Margin="16,20,0,0" Kind="PackageVariantClosed" Width="35" Height="35"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Margin="6,0,0,0" Text="总检测数" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTotal" Text="0" Style="{StaticResource KpiValue}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock x:Name="TxtTotalSub" Text="今日累计" Style="{StaticResource KpiSub}"/>
                            </StackPanel>
                            <md:PackIcon Kind="ChartBar" Width="52" Height="52"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Opacity="0.6" Margin="0,0,-4,-4"/>
                        </Grid>
                    </md:Card>

                    <!-- 合格数 -->
                    <md:Card Margin="0,0,8,0" Padding="6,14">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" >
                                    <md:PackIcon Margin="16,20,0,0" Kind="CheckCircle" Width="35" Height="35"
                                                 Foreground="#4CAF50" VerticalAlignment="Center"/>
                                    <TextBlock Margin="6,0,0,0" Text="合格数 (OK)" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOk" Text="0" Style="{StaticResource KpiValue}"
                                           Foreground="#4CAF50"/>
                                <TextBlock x:Name="TxtOkSub" Text="--" Style="{StaticResource KpiSub}"/>
                            </StackPanel>
                            <md:PackIcon Kind="CheckAll" Width="52" Height="52"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Opacity="0.6" Margin="0,0,-4,-4"/>
                        </Grid>
                    </md:Card>

                    <!-- 不合格数 -->
                    <md:Card Margin="0,0,8,0" Padding="16,14">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"  >
                                    <md:PackIcon Margin="16,20,0,0" Kind="CloseCircle" Width="35" Height="35"
                                                 Foreground="#F44336" VerticalAlignment="Center"/>
                                    <TextBlock Margin="6,0,0,0" Text="不合格数 (NG)" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtNg" Text="0" Style="{StaticResource KpiValue}"
                                           Foreground="#F44336"/>
                                <TextBlock x:Name="TxtNgSub" Text="--" Style="{StaticResource KpiSub}"/>
                            </StackPanel>
                            <md:PackIcon Kind="AlertCircle" Width="52" Height="52"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Opacity="0.6" Margin="0,0,-4,-4"/>
                        </Grid>
                    </md:Card>

                    <!-- 良品率 -->
                    <md:Card Margin="0,0,8,0" Padding="16,14">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"  >
                                    <md:PackIcon Margin="6,0,0,0" Kind="Speedometer" Width="15" Height="15"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Margin="6,0,0,0" Text="良品率" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtRate" Text="--%"
                                           Style="{StaticResource KpiValue}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock x:Name="TxtRateSub" Text="目标 ≥99.5%"
                                           Style="{StaticResource KpiSub}"/>
                            </StackPanel>
                            <md:PackIcon Kind="TrendingUp" Width="52" Height="52"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Opacity="0.6" Margin="0,0,-4,-4"/>
                        </Grid>
                    </md:Card>

                    <!-- 产线状态大灯 -->
                    <md:Card Padding="12,14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Margin="8,0,0,10" Text="产线状态" Style="{StaticResource KpiLabel}"
                                       HorizontalAlignment="Center"/>

                            <Grid  Margin="8,0,0,0" Width="72" Height="72" HorizontalAlignment="Center">
                                <!-- 外圈光晕 -->
                                <Ellipse x:Name="EllGlow" Width="72" Height="72"
                                         Fill="Transparent" StrokeThickness="2" Stroke="#4CAF50"
                                         Opacity="0.5"/>
                                <!-- 主灯 -->
                                <Ellipse x:Name="EllLight" Width="54" Height="54"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush x:Name="LightBrush">
                                            <GradientStop Color="#66BB6A" Offset="0"/>
                                            <GradientStop Color="#2E7D32" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect x:Name="LightGlow" Color="#4CAF50"
                                                          BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <!-- 状态字 -->
                                <TextBlock  Margin="0,0,0,0" x:Name="TxtLightLabel" Text="--"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="White"/>
                            </Grid>

                            <!-- 最近电芯码 -->
                            <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                    CornerRadius="10" Padding="8,2"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtLightCode" Text="--"
                                           FontFamily="Consolas" FontSize="10"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </Border>
                            <TextBlock x:Name="TxtLightTime" Text="--"
                                       FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </md:Card>
                </UniformGrid>

                <!-- ─ 第二行：图表 ───────────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 时段产量图 -->
                    <md:Card Grid.Column="0" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal"   Margin="0,0,0,6">
                                <md:PackIcon Kind="ChartBar" Width="15" Height="15"  Margin="6,0,0,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="时段产量分布（按小时）" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <!-- 图例 -->
                                <StackPanel Orientation="Horizontal"  Margin="12,0,0,0">
                                    <StackPanel Margin="10,0,0,0" Orientation="Horizontal"  >
                                        <Rectangle Margin="4,0,0,0" Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" RadiusX="2" RadiusY="2"/>
                                        <TextBlock Margin="4,0,0,0" Text="OK" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" >
                                        <Rectangle Margin="4,0,0,0"  Width="10" Height="10" Fill="#F44336" VerticalAlignment="Center" RadiusX="2" RadiusY="2"/>
                                        <TextBlock Margin="4,0,0,0"  Text="NG" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <!-- 图表画布：SizeChanged 时重绘 -->
                            <!--<Canvas x:Name="HourlyCanvas" Grid.Row="1"
                                    SizeChanged="HourlyCanvas_SizeChanged"
                                    ClipToBounds="True"/>-->

                            <Grid Grid.Row="1"  >
                                <Grid Margin="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>


                                    <!-- 图表 -->

                                    <Grid Grid.Row =" 1" >
                                        <dxc:ChartControl x:Name="NgHourlyChart" >
                                            <dxc:ChartControl.Resources>
                                                <x:Array x:Key="HardCodedData" Type="{x:Type dxc:SeriesPoint}">
                                                </x:Array>
                                            </dxc:ChartControl.Resources>

                                            <dxc:XYDiagram2D EqualBarWidth="True" Margin="0,-60,0,0">
                                                <dxc:XYDiagram2D.AxisY>
                                                    <dxc:AxisY2D>
                                                        <dxc:AxisY2D.Title>
                                                            <dxc:AxisTitle Content="产量 (pcs)" />
                                                        </dxc:AxisY2D.Title>
                                                    </dxc:AxisY2D>
                                                </dxc:XYDiagram2D.AxisY>

                                                <dxc:XYDiagram2D.AxisX>
                                                    <dxc:AxisX2D>
                                                        <dxc:AxisX2D.Title>
                                                            <dxc:AxisTitle Content="时间" />
                                                        </dxc:AxisX2D.Title>
                                                    </dxc:AxisX2D>
                                                </dxc:XYDiagram2D.AxisX>

                                                <dxc:BarStackedSeries2D DisplayName="OK 产量" 
                                        Brush="ForestGreen" 
                                        LabelsVisibility="True">
                                                    <dxc:BarStackedSeries2D.Points>
                                                        <dxc:SeriesPoint Argument="八点" Value="85" />
                                                        <dxc:SeriesPoint Argument="九点" Value="92" />
                                                        <dxc:SeriesPoint Argument="十点" Value="78" />
                                                    </dxc:BarStackedSeries2D.Points>
                                                    <dxc:BarStackedSeries2D.Label>
                                                        <dxc:SeriesLabel TextPattern="{}{V}" Indent="5" />
                                                    </dxc:BarStackedSeries2D.Label>
                                                </dxc:BarStackedSeries2D>

                                                <dxc:BarStackedSeries2D DisplayName="NG 产量" 
                                        Brush="Crimson" 
                                        LabelsVisibility="True">
                                                    <dxc:BarStackedSeries2D.Points>
                                                        <dxc:SeriesPoint Argument="八点" Value="15" />
                                                        <dxc:SeriesPoint Argument="九点" Value="8" />
                                                        <dxc:SeriesPoint Argument="十点" Value="22" />
                                                    </dxc:BarStackedSeries2D.Points>
                                                    <dxc:BarStackedSeries2D.Label>
                                                        <dxc:SeriesLabel TextPattern="{}{V}" Indent="5" />
                                                    </dxc:BarStackedSeries2D.Label>
                                                </dxc:BarStackedSeries2D>

                                            </dxc:XYDiagram2D>

                                            <dxc:ChartControl.Legend>
                                                <dxc:Legend HorizontalPosition="Right" VerticalPosition="TopOutside" Orientation="Horizontal"/>
                                            </dxc:ChartControl.Legend>

                                            <dxc:ChartControl.Titles>
                                                <dxc:Title Content="小时生产质量分布图" HorizontalAlignment="Center" />
                                            </dxc:ChartControl.Titles>
                                        </dxc:ChartControl>
                                    </Grid>

                                </Grid>
                            </Grid>
                        </Grid>
                    </md:Card>

                    <!-- NG 类型横向条形图 -->
                    <md:Card Grid.Column="2" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal"   Margin="0,0,0,6">
                                <md:PackIcon Kind="ChartDonut" Width="15" Height="15" Margin="0,0,0,6"
                                             Foreground="#F44336" VerticalAlignment="Center"/>
                                <TextBlock Text="NG 类型分布" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <!--<ItemsControl x:Name="NgTypeList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            -->
                                <!-- 绑定 NgTypeData -->
                                <!--
                                            <StackPanel Margin="0,0,0,8">
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    <TextBlock Text="{Binding Count}"
                                                               HorizontalAlignment="Right"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                </Grid>
                                                -->
                                <!-- 进度条：Width 由 code-behind 的 MaxCount 算出，
                                                     这里绑定到 BarWidth（在 NgTypeBarItem 包装类上） -->
                                <!--
                                                <Border Height="6" CornerRadius="3"
                                                        Background="#F44336"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>-->
                                <dxc:ChartControl Name="NgPieChart"  Padding="0">
                                    <dxc:ChartControl.Palette>
                                        <dxc:PastelKitPalette />
                                    </dxc:ChartControl.Palette>

                                    <dxc:ChartControl.Titles>
                                        <dxc:Title Content="NG 类型分布" HorizontalAlignment="Center" FontSize="14" Margin="0,10,0,0"/>
                                    </dxc:ChartControl.Titles>

                                    <dxc:ChartControl.Legend>
                                        <dxc:Legend HorizontalPosition="Center" 
                    VerticalPosition="BottomOutside" 
                    Orientation="Horizontal" 
                    Padding="2" 
                    Margin="0,0,0,5"
                    FontSize="10"/>
                                    </dxc:ChartControl.Legend>

                                    <dxc:SimpleDiagram2D Margin="0">
                                        <dxc:PieSeries2D x:Name="NgPieSeries" 
                         LabelsVisibility="True"
                         ArgumentDataMember="Name"
                         ValueDataMember="Count">
                                            <dxc:PieSeries2D.Points>
                                                <dxc:SeriesPoint Argument="外观缺陷" Value="15" />
                                                <dxc:SeriesPoint Argument="尺寸超差" Value="12" />
                                                <dxc:SeriesPoint Argument="性能不合格" Value="8" />
                                                <dxc:SeriesPoint Argument="物料损伤" Value="5" />
                                                <dxc:SeriesPoint Argument="其他" Value="3" />
                                            </dxc:PieSeries2D.Points>

                                            <dxc:PieSeries2D.Label>
                                                <dxc:SeriesLabel TextPattern="{}{VP:P0}" 
                                 dxc:PieSeries.LabelPosition="Inside"
                                 FontSize="9" />
                                            </dxc:PieSeries2D.Label>

                                            <dxc:PieSeries2D.HoleRadiusPercent>30</dxc:PieSeries2D.HoleRadiusPercent>

                                            <dxc:PieSeries2D.Model>
                                                <dxc:FlatPie2DModel />
                                            </dxc:PieSeries2D.Model>
                                        </dxc:PieSeries2D>
                                    </dxc:SimpleDiagram2D>
                                </dxc:ChartControl>
                            </ScrollViewer>
                        </Grid>
                    </md:Card>
                </Grid>

                <!-- ─ 第三行：最近记录表格 ───────────────────────── -->
                <md:Card Grid.Row="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,10,14,6">
                            <StackPanel Orientation="Horizontal"   VerticalAlignment="Center">
                                <md:PackIcon Kind="FormatListBulleted" Width="16" Height="16" Margin="0,0,0,8"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="最近检测记录" FontSize="13" FontWeight="Medium"  Margin="0,0,0,8"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource PrimaryHueLightBrush}" Margin="0,0,0,8"
                                        CornerRadius="10" Padding="8,1">
                                    <TextBlock x:Name="TxtRecordCount" Text="0 条"
                                               FontSize="11"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                       VerticalAlignment="Center">
                                <TextBlock Text="仅看 NG" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,8"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <ToggleButton x:Name="TglNgOnly"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" Margin="0,0,0,8"
                                              Checked="TglNgOnly_Checked" Unchecked="TglNgOnly_Checked"/>
                                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                                    <Button x:Name="BtnFirstPage" Content="首页" Padding="5,2" FontSize="10"
                                            Click="BtnFirstPage_Click" Margin="2,0"/>
                                    <Button x:Name="BtnPrevPage" Content="上一页" Padding="5,2" FontSize="10"
                                            Click="BtnPrevPage_Click" Margin="2,0"/>
                                    <Button x:Name="BtnNextPage" Content="下一页" Padding="5,2" FontSize="10"
                                            Click="BtnNextPage_Click" Margin="2,0"/>
                                    <Button x:Name="BtnLastPage" Content="末页" Padding="5,2" FontSize="10"
                                            Click="BtnLastPage_Click" Margin="2,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Separator Grid.Row="0" VerticalAlignment="Bottom"/>

                        <DataGrid Grid.Row="1" x:Name="DgRecords"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="True" SelectionMode="Single"
                                  md:DataGridAssist.CellPadding="10,7"
                                  md:DataGridAssist.ColumnHeaderPadding="10,9"
                                  MaxHeight="250"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="电芯码"  Binding="{Binding CellCode}"
                                                    Width="180" FontFamily="Consolas" FontSize="12"/>
                                <DataGridTextColumn Header="时间"    Binding="{Binding DateTime}"
                                                    Width="155" FontFamily="Consolas" FontSize="11"/>
                                <DataGridTemplateColumn Header="状态" Width="70" SortMemberPath="IsInbound">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInbound}" Value="True">
                                                                <Setter Property="Background" Value="#1A2196F3"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInbound}" Value="False">
                                                                <Setter Property="Background" Value="#1AFF9800"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInbound}" Value="True">
                                                                    <Setter Property="Text" Value="进站"/>
                                                                    <Setter Property="Foreground" Value="#2196F3"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsInbound}" Value="False">
                                                                    <Setter Property="Text" Value="出站"/>
                                                                    <Setter Property="Foreground" Value="#FF9800"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="工位"    Binding="{Binding StationId}" Width="70"/>

                                <!-- 判定列：带颜色 Badge -->
                                <DataGridTemplateColumn Header="判定" Width="80" SortMemberPath="OverallResult">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OverallResult}" Value="OK">
                                                                <Setter Property="Background" Value="#1A4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OverallResult}" Value="NG">
                                                                <Setter Property="Background" Value="#1AF44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding OverallResult}"
                                                           FontFamily="Consolas" FontWeight="Bold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OverallResult}" Value="OK">
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OverallResult}" Value="NG">
                                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- NG 类型 -->
                                <DataGridTemplateColumn Header="NG 类型" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding NgTypeList}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="3" Margin="2,1"
                                                                Background="#1AFFC107" Padding="5,1">
                                                            <TextBlock Text="{Binding}" FontSize="10"
                                                                       Foreground="#FFC107"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="耗时(ms)" Binding="{Binding ProcessMs}"
                                                    Width="90" FontFamily="Consolas" FontSize="11"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>

            </Grid>
        </DockPanel>
    </ScrollViewer>
</UserControl>
