<Window x:Class="LoginProject.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="蓝膜外观检测系统 - 登录"
        Height="550"
        Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid>
        <!-- 背景渐变 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#667eea" Offset="0"/>
                <GradientStop Color="#764ba2" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <materialDesign:Card UniformCornerRadius="15"
                             materialDesign:ElevationAssist.Elevation="Dp6"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题区域 -->
                <StackPanel Grid.Row="0" Margin="0,30,0,20" HorizontalAlignment="Center">
                    <!-- 图标 -->
                    <materialDesign:PackIcon Kind="ShieldAccount"
                                             Width="60"
                                             Height="60"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                    <!-- 系统标题 -->
                    <TextBlock Text="蓝膜外观检测系统"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                    <!-- 副标题 -->
                    <TextBlock Text="用户登录"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"
                               Opacity="0.7"/>
                </StackPanel>

                <!-- 登录表单区域 -->
                <StackPanel Grid.Row="1" Margin="40,0,40,0" VerticalAlignment="Center">

                    <!-- 用户名 -->
                    <TextBox x:Name="txtUsername"
                             materialDesign:HintAssist.Hint="用户名"
                             materialDesign:HintAssist.IsFloating="True"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,20">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FocusNextCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- 密码 -->
                    <PasswordBox x:Name="txtPassword"
                                 materialDesign:HintAssist.Hint="密码"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 Margin="0,0,0,20">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                        </PasswordBox.InputBindings>
                    </PasswordBox>

                    <!-- 记住我 & 忘记密码 -->
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Content="记住我"
                                  VerticalAlignment="Center"
                                  materialDesign:CheckBoxAssist.CheckBoxSize="20"/>

                        <Button Grid.Column="1"
                                Content="忘记密码?"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Right"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    </Grid>

                    <!-- 登录按钮 -->
                    <Button x:Name="btnLogin"
                            Content="登 录"
                            Height="45"
                            FontSize="16"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ElevationAssist.Elevation="Dp3"
                            Click="btnLogin_Click">
                        <Button.Background>
                            <SolidColorBrush Color="#667eea"/>
                        </Button.Background>
                    </Button>
                </StackPanel>

                <!-- 底部版本信息 -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Version 1.0.0"
                               FontSize="12"
                               Opacity="0.5"/>
                    <TextBlock Text=" | "
                               FontSize="12"
                               Opacity="0.5"/>
                    <TextBlock Text="2026"
                               FontSize="12"
                               Opacity="0.5"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- 版本信息 - 右下角 -->
        <TextBlock Text="蓝膜外观检测系统 V1.0.0"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Right"
                   Margin="0,0,30,10"
                   Foreground="White"
                   Opacity="0.7"
                   FontSize="11"/>
    </Grid>
</Window>